# Copiar a .env.production en VM; chmod 600. No completar este ejemplo en Git.
API_DOMAIN=DOMINIO_API
ACME_EMAIL=CORREO_OPERADOR
SERVIPROX_RELEASE=COMMIT_O_TAG
DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=DOMINIO_API,127.0.0.1
# Subir a 31536000 despues de comprobar HTTPS; no enviar dominio a listas preload aun.
DJANGO_SECURE_HSTS_SECONDS=3600
CSRF_TRUSTED_ORIGINS=https://DOMINIO_API
# Dominio encontrado en repo: confirmar. Android/iOS con origenes predeterminados.
CORS_ALLOWED_ORIGINS=https://serviproxweb.netlify.app,https://localhost,capacitor://localhost
SERVIPROX_DATABASE=postgres
POSTGRES_DB=serviprox
POSTGRES_USER=serviprox
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
SERVIPROX_MEDIA_STORAGE=filesystem
DEFAULT_SEARCH_RADIUS_KM=5
GUNICORN_WORKERS=2
TIME_ZONE=America/Bogota
# SMTP para recuperar contrasenas; no se imprimen codigos en produccion.
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
