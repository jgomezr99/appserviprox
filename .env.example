DJANGO_SECRET_KEY=change-me-in-local-env
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

POSTGRES_DB=serviprox
POSTGRES_USER=serviprox
POSTGRES_PASSWORD=serviprox_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=

WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost

DEFAULT_SEARCH_RADIUS_KM=5

SERVIPROX_MEDIA_STORAGE=filesystem
SERVIPROX_S3_ACCESS_KEY_ID=
SERVIPROX_S3_SECRET_ACCESS_KEY=
SERVIPROX_S3_BUCKET_NAME=
SERVIPROX_S3_REGION_NAME=
SERVIPROX_S3_ENDPOINT_URL=
SERVIPROX_S3_ADDRESSING_STYLE=
SERVIPROX_S3_LOCATION=media

# Leave empty in local development to use the Vite /api proxy. Set a public HTTPS URL for deployment.
VITE_API_URL=

# Recuperacion de contrasena. Configura estas variables con los datos SMTP de tu proveedor.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
